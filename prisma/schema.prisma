generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  MODERATOR
  ADMIN
}

enum UserStatus {
  ACTIVE
  BANNED
}

enum ToiletKind {
  GRATUIT
  PAYANT
  COMMERCE
}

enum ToiletStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ReviewStatus {
  PUBLISHED
  REJECTED
}

enum CompletionStatus {
  PENDING
  APPROVED
  REJECTED
}

enum NotificationType {
  TOILET
  REVIEW
  COMPLETION
}

enum NotificationStatus {
  APPROVED
  REJECTED
  PARTIAL
}

model User {
  id            Int      @id @default(autoincrement())
  /// Private login identifier (distinct from the public `pseudo`), stored trimmed + lowercased.
  username      String   @unique @map("username")
  /// bcrypt, cost 12.
  passwordHash  String   @map("password_hash")
  pseudo        String
  role          UserRole @default(USER)
  status        UserStatus @default(ACTIVE)
  createdAt     DateTime @default(now()) @map("created_at")

  sessions            Session[]
  toilets             Toilet[]
  reviews             Review[]
  photos              Photo[]
  toiletsNamed        Toilet[]       @relation("ToiletNameSetBy")
  completions         Completion[]
  completionsReviewed Completion[]   @relation("CompletionReviewedBy")
  notifications       Notification[]

  @@map("users")
}

model Session {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime @map("expires_at")

  @@map("sessions")
}

model Toilet {
  id              Int          @id @default(autoincrement())
  /// Nullable: OSM-seeded toilets often carry no name tag. Null means "not yet named" —
  /// see `nameSetById` — as opposed to user-submitted toilets, which always require one.
  name            String?
  lat             Float
  lng             Float
  address         String?
  kind            ToiletKind   @default(GRATUIT)
  price           String?
  description     String?
  status          ToiletStatus @default(PENDING)
  /// External id ("node/123456") when seeded from OSM Overpass — used for idempotent re-seeding.
  osmId           String?      @unique @map("osm_id")
  createdById     Int?         @map("created_by")
  createdBy       User?        @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdByPseudo String       @default("Anonyme") @map("created_by_pseudo")
  createdAt       DateTime     @default(now()) @map("created_at")
  /// Denormalized from `reviews` (kept in sync on write) so the map's bulk sync — tens
  /// of thousands of rows — never has to join the reviews table just to color a pin.
  reviewCount     Int          @default(0) @map("review_count")
  /// Denormalized average of (proprete+confort+experience)/3 across all reviews.
  avgScore        Float        @default(0) @map("avg_score")
  /// Set when a logged-in user fills in a missing name via "complete this spot" (first
  /// come, first served — null again after an admin reset, which reopens it for naming).
  /// Never set for user-submitted toilets, which already require a name up front.
  nameSetById     Int?         @map("name_set_by")
  nameSetBy       User?        @relation("ToiletNameSetBy", fields: [nameSetById], references: [id], onDelete: SetNull)

  reviews     Review[]
  photos      Photo[]
  completions Completion[]

  @@index([status])
  @@map("toilets")
}

model Review {
  id         Int          @id @default(autoincrement())
  toiletId   Int          @map("toilet_id")
  toilet     Toilet       @relation(fields: [toiletId], references: [id], onDelete: Cascade)
  userId     Int?         @map("user_id")
  user       User?        @relation(fields: [userId], references: [id], onDelete: Cascade)
  pseudo     String
  proprete   Int
  confort    Int
  experience Int
  comment    String?
  /// Published by default (visible immediately); a moderator can reject it after the
  /// fact — same effect as a delete, but keeps the row for audit instead of hard-deleting.
  status     ReviewStatus @default(PUBLISHED)
  createdAt  DateTime     @default(now()) @map("created_at")

  @@index([toiletId])
  @@index([status])
  @@map("reviews")
}

/// A registered user's proposal to fill in missing info (name / address / comment /
/// photos) on an already-approved toilet. Unlike the old first-come-first-served
/// auto-apply flow, this now always lands in a moderation queue — fields only merge
/// into the `Toilet` once a moderator approves it (in full or in part).
model Completion {
  id           Int              @id @default(autoincrement())
  toiletId     Int              @map("toilet_id")
  toilet       Toilet           @relation(fields: [toiletId], references: [id], onDelete: Cascade)
  userId       Int              @map("user_id")
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String?
  address      String?
  comment      String?
  status       CompletionStatus @default(PENDING)
  createdAt    DateTime         @default(now()) @map("created_at")
  reviewedAt   DateTime?        @map("reviewed_at")
  reviewedById Int?             @map("reviewed_by")
  reviewedBy   User?            @relation("CompletionReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)

  photos CompletionPhoto[]

  @@index([toiletId])
  @@index([status])
  @@map("completions")
}

model CompletionPhoto {
  id           Int        @id @default(autoincrement())
  completionId Int        @map("completion_id")
  completion   Completion @relation(fields: [completionId], references: [id], onDelete: Cascade)
  url          String

  @@map("completion_photos")
}

model Photo {
  id          Int      @id @default(autoincrement())
  toiletId    Int      @map("toilet_id")
  toilet      Toilet   @relation(fields: [toiletId], references: [id], onDelete: Cascade)
  /// Data-URL (base64 JPEG, compressed client-side) or /public path for seeded stock photos.
  url         String
  caption     String?
  createdById Int?     @map("created_by")
  createdBy   User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([toiletId])
  @@map("photos")
}

/// A moderation outcome delivered to the user whose submission it was — created
/// server-side by the moderation endpoints, never by the client. `referenceId` is
/// always the toilet id (even for REVIEW/COMPLETION), since "voir" always means
/// "show me that spot on the map" — there's no standalone review/completion page.
/// Unread count is computed on query (`count(where: {read: false})`) rather than
/// denormalized on `User`: this table stays small per user, so an extra synced
/// counter would add write-coordination risk for no real read-speed benefit.
model Notification {
  id          Int                 @id @default(autoincrement())
  userId      Int                 @map("user_id")
  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        NotificationType
  referenceId Int                 @map("reference_id")
  status      NotificationStatus
  /// Server-generated, human-readable French message — the client never composes this.
  message     String
  /// { keptFields?: string[], rejectedFields?: string[], comment?: string } — populated for PARTIAL.
  details     Json?
  read        Boolean             @default(false)
  createdAt   DateTime            @default(now()) @map("created_at")

  @@index([userId, read])
  @@index([userId, createdAt])
  @@map("notifications")
}

/// Global version counter — bumped on every mutation visible on the map, used for
/// cheap client sync (client sends its last known version, server replies 304 if unchanged).
model Meta {
  key   String @id
  value Int    @default(0)

  @@map("meta")
}
