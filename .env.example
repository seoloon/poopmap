# PostgreSQL connection string used by Prisma.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/poopmap"

# Required: credentials for the admin account created on first launch by the seed
# script. There is no built-in default — the app refuses to seed (and the Docker
# image refuses to start) if either is missing. CHANGE THESE before deploying.
ADMIN_USERNAME="change-me-admin"
ADMIN_PASSWORD="change-me-please-a-strong-password"

# Optional: override the Overpass API mirror used by the OSM seed script.
OVERPASS_URL="https://overpass-api.de/api/interpreter"
